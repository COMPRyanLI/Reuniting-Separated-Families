# Copy to .env (or run `npm run setup:env`, which generates random local keys).
# Placeholders only. Never commit real values.

NODE_ENV=development
PORT=3000
# Exact browser origin that may send state-changing requests.
APP_ORIGIN=http://localhost:5173

# PostgreSQL connection for the app (local Docker default from docker-compose.yml).
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:55432/rf_dev

# 32+ random bytes, base64. Used for purpose-separated HMAC digests of tokens/codes.
DIGEST_KEY=REPLACE_WITH_BASE64_32_BYTES

# Comma-separated versioned AES-256-GCM keys "v1:<base64 32 bytes>,v2:<...>".
# Alternative for single-key hosting: FIELD_ENCRYPTION_KEY=<base64 32 bytes> (treated as v1).
FIELD_ENCRYPTION_KEYS=v1:REPLACE_WITH_BASE64_32_BYTES
FIELD_ENCRYPTION_ACTIVE_KEY=v1
# APP_ORIGIN may be omitted on Render, which sets RENDER_EXTERNAL_URL. Blank variables count as unset.

# Demo mode labels the site as fictional and allows the guarded fictional seed.
DEMO_MODE=true
INCIDENT_SLUG=demo-hurricane-1

# Number of reverse proxies in front of the app (0 locally, usually 1 on a PaaS).
TRUST_PROXY=0

# Worker settings
WORKER_POLL_MS=2000
RETENTION_INTERVAL_MS=600000
# true = run the outbox worker inside the web process (single-process/free hosting).
RUN_WORKER_IN_PROCESS=false

# Seed-only settings (fictional accounts). Must be set explicitly outside development.
# SEED_ON_START=yes makes scripts/start-free.mjs run the idempotent fictional seed at each start.
SEED_PASSWORD=REPLACE_WITH_LOCAL_DEMO_PASSWORD
SEED_SECRET=REPLACE_WITH_RANDOM_STRING

# Test-only: admin URL of a DISPOSABLE PostgreSQL server. Tests create/drop rf_test_* databases.
TEST_DATABASE_ADMIN_URL=postgresql://USER:PASSWORD@127.0.0.1:55432/postgres
