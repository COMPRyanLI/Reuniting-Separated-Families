{
  "name": "family-reunification-prototype",
  "private": true,
  "version": "0.1.0",
  "description": "Consent-based family reunification prototype (fictional demo data only).",
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25",
    "npm": ">=11"
  },
  "packageManager": "npm@11.19.1",
  "workspaces": [
    "packages/contracts",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "setup:env": "node scripts/setup-env.mjs",
    "db:up": "docker compose up -d db",
    "dev": "concurrently -k -n api,web,worker -c blue,green,magenta \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:worker\"",
    "dev:api": "tsx watch --env-file-if-exists=.env apps/api/src/server.ts",
    "dev:web": "npm run dev -w @rf/web",
    "dev:worker": "tsx watch --env-file-if-exists=.env apps/api/src/worker.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p packages/contracts --noEmit && tsc -p apps/api --noEmit && tsc -p apps/web --noEmit && tsc -p tests --noEmit",
    "build": "npm run build -w @rf/web && npm run build -w @rf/api",
    "start": "node --env-file-if-exists=.env apps/api/dist/server.js",
    "worker": "node --env-file-if-exists=.env apps/api/dist/worker.js",
    "docs:check": "node scripts/docs-check.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "staff:admin": "tsx --env-file-if-exists=.env scripts/staff-admin.ts",
    "ops": "tsx --env-file-if-exists=.env scripts/ops.ts",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:security": "vitest run --project security",
    "test:e2e": "node scripts/e2e.mjs",
    "test:a11y": "node scripts/e2e.mjs --a11y",
    "test:performance": "tsx scripts/perf/run.ts",
    "verify": "node scripts/verify.mjs",
    "smoke:deployed": "tsx scripts/smoke-deployed.ts",
    "drill:restore": "node scripts/restore-drill.mjs",
    "start:free": "node scripts/start-free.mjs",
    "check:free-start": "node --import tsx scripts/free-tier-check.mjs",
    "audit:zoom": "node --import tsx scripts/zoom-audit.mjs",
    "manual:screenshots": "node --import tsx scripts/manual-screenshots.mjs",
    "manual:build": "node scripts/build-manual.mjs",
    "test:hosted": "playwright test -c playwright.hosted.config.ts",
    "postinstall": "prisma generate"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "5.2.0",
    "concurrently": "9.2.5",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prisma": "6.19.3",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
